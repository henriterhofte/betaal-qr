{
  "id": "./",
  "name": "Betaal-QR",
  "short_name": "Betaal-QR",
  "description": "Factuur in je mail? Fluitend betaald. Open de PDF en scan de betaal-QR-code met je bank-app.",
  "lang": "nl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f6",
  "theme_color": "#1c2b30",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./gedeeld",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titel",
      "files": [{ "name": "factuur", "accept": ["application/pdf", ".pdf"] }]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/pdf": [".pdf"] },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ]
}
